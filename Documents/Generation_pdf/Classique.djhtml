          <tbody>

		    	  <tr>
		    		  <td style="width: 32%;">{% trans "Rotation des stocks de mp" %}</td>

              
		    		  <td style="width: 17%;">{{ratio.rotation_des_stock_de_mp.0|arroundDays}}</td>
              

              {% if annee_nn_moins_un %}
    		    		  <td style="width: 17%;">{{ratio.rotation_des_stock_de_mp.1 |arroundDays}}</td>
              {% endif %}


              {% if annee_nn and  annee_nn_moins_un %}
    		    		  <td style="width: 17%; color: {% if ratio.rotation_des_stock_de_mp.var > 0 %}green{%elif ratio.rotation_des_stock_de_mp.var < 0  %} red {% endif %}">{{ratio.rotation_des_stock_de_mp.var| multiply:100 |floatformat:"2"|intcomma }} %</td>
              {% endif %}

		    		 {% if annee_nn_moins_deux %}  
                <td style="width: 17%;">{{ratio.rotation_des_stock_de_mp.2 |arroundDays}}</td> 
             {% endif %}
		    	  </tr>

		    	  <tr>
		    		  <td width="40%">{% trans "Rotation des stocks de PF" %}</td>
		    		  <td width="15%">{{ratio.rotation_des_stock_de_pf.0|arroundDays}}</td>
              
              {% if annee_nn_moins_un %}
		    		    <td width="15%">{{ratio.rotation_des_stock_de_pf.1|arroundDays}}</td>
              {% endif %}

              {% if annee_nn and  annee_nn_moins_un %}
		    		    <td width="15%" style="color: {% if ratio.rotation_des_stock_de_pf.var > 0 %}green{%elif ratio.rotation_des_stock_de_pf.var < 0  %} red {% endif %}">{{ratio.ratio.rotation_des_stock_de_pf.var| multiply:100 |floatformat:"2"|intcomma}} %</td>
              {% endif %}

		    		 {% if annee_nn_moins_deux %}  
              <td width="15%">{{ratio.rotation_des_stock_de_pf.2|arroundDays}}</td> 
             {% endif %}
		    	  </tr>

		    	  <tr>
		    		  <td width="40%">{% trans "Rotation des stocks de marchandises" %}</td>
		    		  <td width="15%">{{ratio.rotation_des_stock_de_marchandises.0|arroundDays}}</td>
              
              {% if annee_nn_moins_un %}
		    		    <td width="15%">{{ratio.rotation_des_stock_de_marchandises.1|arroundDays}}</td>
              {% endif %}

              {% if annee_nn and  annee_nn_moins_un %}
  		    		  <td width="15%" style="color: {% if ratio.rotation_des_stock_de_marchandises.var > 0 %}green{%elif ratio.rotation_des_stock_de_marchandises.var < 0  %} red {% endif %}">{{ratio.rotation_des_stock_de_marchandises.var| multiply:100 |floatformat:"2"|intcomma}} %
                </td>
              {% endif %}

		    		  {% if annee_nn_moins_deux %} 
                <td width="15%">{{ratio.rotation_des_stock_de_marchandises.2 |arroundDays}}</td> 
              {% endif %}

		    	  </tr>
		    	  <tr>
		    		  <td width="40%">{% trans "Rotation des stocks de services" %}</td>
		    		  <td width="15%">{{ratio.rotation_des_stock_de_services.0|arroundDays}}</td>
              {% if annee_nn_moins_un %}
		    		    <td width="15%">{{ratio.rotation_des_stock_de_services.1 |arroundDays}}</td>
              {% endif %}

              {% if annee_nn and  annee_nn_moins_un %}
  		    		  <td width="15%"  style="color: {% if ratio.rotation_des_stock_de_services.var > 0 %}green{%elif ratio.rotation_des_stock_de_services.var < 0  %} red {% endif %}">{{ratio.rotation_des_stock_de_services.var| multiply:100 |floatformat:"2"|intcomma}} %
                </td>
              {% endif %}



		    		  {% if annee_nn_moins_deux %} 
                <td width="15%">{{ratio.rotation_des_stock_de_services.2|arroundDays}}</td> 
              {% endif %}
		    	  </tr>

		    	  <tr>
		    		  <td width="40%">{% trans "Crédit clients" %}</td>
		    		  <td width="15%">{{ratio.credit_clients.0|arroundDays}}</td>
              
              {% if annee_nn_moins_un %}
		    		    <td width="15%">{{ratio.credit_clients.1 |arroundDays}}</td>
              {% endif %}

              {% if annee_nn and  annee_nn_moins_un %}
		    		    <td width="15%" style="color: {% if ratio.credit_clients.var > 0 %}green{%elif ratio.credit_clients.var < 0  %} red {% endif %}">{{ratio.credit_clients.var| multiply:100|floatformat:"2"|intcomma}} %</td>
              {% endif %}
		    		  {% if annee_nn_moins_deux %} <td width="15%">{{ratio.credit_clients.2 |arroundDays}}</td> {% endif %}
		    	  </tr>
		    	  <tr>
		    		  <td width="40%">{% trans "Crédits fournisseurs" %}</td>
		    		  <td width="15%">{{ratio.credits_fournisseurs.0|arroundDays}}</td>
              
              {% if annee_nn_moins_un %}
		    		    <td width="15%">{{ratio.credits_fournisseurs.1|arroundDays}} </td>
              {% endif %}

              {% if annee_nn and  annee_nn_moins_un %}
		    		    <td width="15%"  style="color: {% if ratio.credits_fournisseurs.var > 0 %}green{%elif ratio.credits_fournisseurs.var < 0  %} red {% endif %}">{{ratio.credits_fournisseurs.var| multiply:100|floatformat:"2"|intcomma}} %</td>
              {% endif %}


		    		  {% if annee_nn_moins_deux %} <td width="15%">{{ratio.credits_fournisseurs.2|arroundDays}}</td> {% endif %}
		    	  </tr>
    		  </tbody>



        </table>


        <br>

        <p style="text-align: justify;" style="text-justify: inter-word;">
          <strong style="color:#e3c111">{% trans "Commentaire" %}:</strong>

              {% for op in acheteur.operationethistorique_set.all %}
                      <span> 
                        {% autoescape off %}
                          {% traduit op.commentaire_ratios|default_if_none:""|linebreaksbr  %}
                        {% endautoescape %}

                      </span>
              {% endfor %}

        </p>


		  </div>

      <br>
      <div style="border: 1px solid #e4c010; border-radius:10px"><br>



		    <div>
			    <div class="col-12 text-center mb-12">
				    <strong style="color:#e3c111">{% trans "Structure financière" %}</strong><br>
				    <img src="https://backendbucrep.acremac.net/static/fichiers_ratios/{{acheteur.nom }}/str_fin.png"  class="summary" alt="" style="width: 700px" />


          </div>

			    <div>


			      <div class="col-12 text-center mb-12">
				      <strong style="color:#e3c111">{% trans "Rentabilité financière" %}</strong><br>
			        <img src="https://backendbucrep.acremac.net/static/fichiers_ratios/{{acheteur.nom }}/renta_fin.png"  class="summary" alt="" style="width: 700px" />
        	  </div>
				    <div class="col-12 text-center mb-12">
				      <strong style="color:#e3c111">{% trans "Délais" %}</strong><br>

			        <img src="https://backendbucrep.acremac.net/static/fichiers_ratios/{{acheteur.nom }}/delais.png"  class="summary" alt="" style="width: 700px" />

            </div>


		      </div>

        </div>
      </div><br>
    {% endif %}


