{% load static %}
{% load report_extras %}
{% load qr_code %}
{% load i18n %}

{% load humanize %}




    {% if annee %}
      {% if actifs.0 %}
        <div class="row mt-2" style="background-color: #000066; color: white;border-radius: 10px;">
          <div class="col-12 text-center">
            <h3><strong>{% trans "ACTIF" %}</strong></h3>
          </div>
        </div>
        <br>
        <div style="border: 1px solid #e4c010; border-radius:10px">
          <h5><strong>{% trans "ELEMENTS NETS DU BILAN ACTIF" %}</strong></h5> <br>
          <table class="table_bilan">
         	  <thead>
         	    <tr>
                <th  style="width: 32%;"></th>
                {% for a in actifs %}<th style="width: 17%">FY {{ a.annee }}</th>{% if forloop.counter == 2 %}<th style="width: 17%">VAR</th>{% endif %}{% endfor %}
		    	    </tr>
         	  </thead>
    		    <tbody>
    			    <tr>
		    		    <td width="40%">{% trans "Capital sousc. non app" %}.</td>
                {% for a in actifs %}
                  {% if a %}
		    		        <td width="15%">{{a.capital_souscrit_non_app|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%" style=" color: {% var_color actifs.0 actifs.1 'capital_souscrit_non_app' %}">{% var actifs.0 actifs.1 'capital_souscrit_non_app' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>
    		    </tbody>
          </table>
          <br>
          <h5><strong>{% trans "ACTIF IMMOBILISE" %}</strong></h5>
          <table class="table_bilan">
         	  <thead>
         	    <tr>
                <th  style="width: 32%;"></th>
                {% for a in actifs %}<th style="width: 17%">FY {{ a.annee }}</th>{% if forloop.counter == 2 %}<th style="width: 17%">VAR</th>{% endif %}{% endfor %}
		    	    </tr>
         	  </thead>
    		    <tbody>
              <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
                <td width="40%">{% trans "Eléments incorporels" %}</td>
                {% for a in actifs %}
                  {% if a %}
		    		        <td width="15%">{{a.elements_incorporels|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%" style="color: {% var_color actifs.0 actifs.1 'elements_incorporels' %}">{% var actifs.0 actifs.1 'elements_incorporels' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>

              {% autoescape off %}
		    	      {% tab actifs 'frais_recherche_developpement' 'autres_immobilisations_incorporelles' %}
              {% endautoescape%}
		    	    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%">{% trans "Eléments corporels" %}</td>
                {% for a in actifs %}
                  {% if a %}
		    		        <td width="15%">{{a.elements_corporels|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%"  style="color: {% var_color actifs.0 actifs.1 'elements_corporels' %}">{% var actifs.0 actifs.1 'elements_corporels' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>
              {% autoescape off %}
		    	      {% tab actifs 'terrains' 'avances_et_acptes' %}
              {% endautoescape%}

		    	    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%">{% trans "Eléments financiers" %}</td>
                {% for a in actifs %}
                  {% if a %}
		    		        <td width="15%">{{a.elements_financiers|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%"   style=" color: {% var_color actifs.0 actifs.1 'elements_financiers' %}">{% var actifs.0 actifs.1 'elements_financiers' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>

              {% autoescape off %}
		    	      {% tab actifs 'participations' 'autres' %}
              {% endautoescape%}

		    	    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%">TOTAL I</td>
                {% for a in actifs %}
                  {% if a %}
		    		        <td width="15%">{{a.total_I|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%" style=" color: {% var_color actifs.0 actifs.1 'total_I' %}">{% var actifs.0 actifs.1 'total_I' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>
    		    </tbody>
          </table>
          <br>

          <h5><strong>{% trans "ACTIF CIRCULANT" %}</strong></h5>
          <table class="table_bilan">
         	  <thead>
              <tr>
                <th  style="width: 32%;"></th>
                {% for a in actifs %}<th style="width: 17%">FY {{ a.annee }}</th>{% if forloop.counter == 2 %}<th style="width: 17%">VAR</th>{% endif %}{% endfor %}
		    	    </tr>
         	  </thead>
    		    <tbody>
    			    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td style="width: 30%;">{% trans "Stocks" %}</td>
                {% for a in actifs %}
                  {% if a %}
		    		        <td width="15%">{{a.stocks|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%" style=" color: {% var_color actifs.0 actifs.1 'stocks' %}">{% var actifs.0 actifs.1 'stocks' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>

              {% autoescape off %}
		    	      {% tab actifs 'stocks_mp' 'stocks_mses' %}
              {% endautoescape%}

		    	    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%">{% trans "Créances" %}</td>
                {% for a in actifs %}
                  {% if a %}
		    		        <td width="15%">{{a.creances|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%" style=" color: {% var_color actifs.0 actifs.1 'creances' %}">{% var actifs.0 actifs.1 'creances' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>

              {% autoescape off %}
		    	      {% tab actifs 'avances_acptes_verses' 'autres_creances' %}
              {% endautoescape%}

		    	    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%">{% trans "Disponibilités & Vmp" %}</td>
                {% for a in actifs %}
                  {% if a %}
		    		        <td width="15%">{{a.disponibilites_vmp|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%" style=" color: {% var_color actifs.0 actifs.1 'disponibilites_vmp' %}">{% var actifs.0 actifs.1 'disponibilites_vmp' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>

              {% autoescape off %}
		    	      {% tab actifs 'valeurs_a_encaisser' 'banques_cheques_postaux_caisse' %}
              {% endautoescape%}

		    	    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%">TOTAL II</td>
                {% for a in actifs %}
                  {% if a %}
		    		        <td width="15%">{{a.total_II|floatformat:"2"|intcomma}}</td>
		    		      {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%"   style=" color: {% var_color actifs.0 actifs.1 'total_II' %}">{% var actifs.0 actifs.1 'total_II' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>
     		    </tbody>
          </table>
          <br>

          <div class="row">
            <div class="col col-sm-12"><h5><strong><U>{% trans "COMPTES DE REGUL" %}</U></strong></h5></div>
          </div>
          <table class="table_bilan">
         	  <thead>
              <thead>
                <tr>
                  <th  style="width: 32%;"></th>
                  {% for a in actifs %}<th style="width: 17%">FY {{ a.annee }}</th>{% if forloop.counter == 2 %}<th style="width: 17%">VAR</th>{% endif %}{% endfor %}
		    	      </tr>
         	    </thead>
         	  </thead>
    		    <tbody>
    			    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%">{% trans "Comptes de regul" %}</td>
                {% for a in actifs %}
                  {% if a %}
		    		        <td width="15%">{{a.compte_regul|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%"    style=" color: {% var_color actifs.0 actifs.1 'compte_regul' %}">{% var actifs.0 actifs.1 'compte_regul' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>
              {% autoescape off %}
		    	      {% tab actifs 'cca' 'eca' %}
              {% endautoescape%}

		    	    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%" >TOTAL III</td>
                {% for a in actifs %}
                  {% if a %}
		    		        <td width="15%">{{a.total_III|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%"  style=" color: {% var_color actifs.0 actifs.1 'total_III' %}">{% var actifs.0 actifs.1 'total_III' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>
				      <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%" >TOTAL GENERAL</td>
                {% for a in actifs %}
                  {% if a %}
		    		        <td width="15%">{{a.general_total|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%"  style=" color: {% var_color actifs.0 actifs.1 'general_total' %}" >{% var actifs.0 actifs.1 'general_total' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>
    		    </tbody>
          </table>
          <br>

          <div class="row">
            <div class="col col-sm-12"><h5><strong>{% trans "INFOS HORS BILAN" %}</strong></h5></div>
          </div>
          <table class="table_bilan">
         	  <thead>
              <tr>
                <th  style="width: 32%;"></th>
                {% for a in actifs %}<th style="width: 17%">FY {{ a.annee }}</th>{% if forloop.counter == 2 %}<th style="width: 17%">VAR</th>{% endif %}{% endfor %}
		    	    </tr>
         	  </thead>
    		    <tbody>
              {% autoescape off %}
		    	      {% tab actifs 'eene' 'provisions_vmp' %}
              {% endautoescape%}
    		    </tbody>
          </table>
</br>
        </div>
        </br>
      {% endif %}
      {% if passifs.0 %}
        <div class="row mt-2" style="background-color: #000066; color: white;border-radius: 10px;">
          <div class="col-12 text-center">
            <h3><strong>{% trans "PASSIF" %}</strong></h3>
          </div>
        </div> <br>

        <div style="border: 1px solid #e4c010; border-radius:10px"><br>
          <h5><strong>{% trans "ELEMENTS BILAN PASSIF" %}</strong></h5> <br>
          <table class="table_bilan">
         	  <thead>
              <tr>
                <th  style="width: 32%;"></th>
                {% for a in passifs %}<th style="width: 17%">FY {{ a.annee }}</th>{% if forloop.counter == 2 %}<th style="width: 17%">VAR</th>{% endif %}{% endfor %}
		    	    </tr>
         	  </thead>
    		    <tbody>
    			    <tr>
		    		    <td style="width: 32%;">{% trans "CAPITAUX PROPRES" %}</td>
		    	    </tr>

              {% autoescape off %}
		    	      {% tab passifs 'capital_social' 'provision_regl' %}
              {% endautoescape%}

		    	    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%" >TOTAL I</td>
                {% for p in passifs %}
                  {% if p %}
		    		        <td width="15%">{{p.total_I|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%"  style=" color: {% var_color passifs.0 passifs.1 'total_I' %}">{% var passifs.0 passifs.1 'total_I' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>
    		    </tbody>
          </table>

          <div class="row">
            <div class="col col-sm-4"><h5><strong>{% trans "DETTES FINANCIERES ET RESSOURCES" %}</strong></h5></div>
          </div>
          <table class="table_bilan">
         	  <thead>
              <tr>
                <th  style="width: 32%;"></th>
                {% for a in passifs %}<th style="width: 17%">FY {{ a.annee }}</th>{% if forloop.counter == 2 %}<th style="width: 17%">VAR</th>{% endif %}{% endfor %}
		    	    </tr>
         	  </thead>
    		    <tbody>
              {% autoescape off %}
		    	      {% tab passifs 'emprunts' 'provision_financiere_risque_charge' %}
              {% endautoescape%}
              <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%" >{% trans "TOTAL II | DETTES FINANCIERES" %}</td>
                {% for p in passifs %}
                  {% if p %}
		    		        <td width="15%">{{p.total_II|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%"  style=" color: {% var_color passifs.0 passifs.1 'total_II' %}">{% var passifs.0 passifs.1 'total_II' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>
              <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%" >{% trans "TOTAL I + II | RESSOURCES STABLES" %}</td>
                {% for p in passifs %}
                  {% if p %}
		    		        <td width="15%">{{p.total_I_II|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%"  style=" color: {% var_color passifs.0 passifs.1 'total_I_II' %}">{% var passifs.0 passifs.1 'total_I_II' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>
    		    </tbody>
          </table>

          <div class="row">
            <div class="col col-sm-4"><h5><strong>{% trans "PASSIF CIRCULANT" %}</strong></h5></div>
          </div>
          <table class="table_bilan">
         	  <thead>
              <tr>
                <th  style="width: 32%;"></th>
                {% for a in passifs %}<th style="width: 17%">FY {{ a.annee }}</th>{% if forloop.counter == 2 %}<th style="width: 17%">VAR</th>{% endif %}{% endfor %}
		    	    </tr>
         	  </thead>
    		    <tbody>
              {% autoescape off %}
		    	      {% tab passifs 'dettes_fournisseurs_divers' 'autres_dettes' %}
              {% endautoescape%}
              <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%" >TOTAL III</td>
                {% for p in passifs %}
                  {% if p %}
		    		        <td width="15%">{{p.total_III|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%"   style=" color: {% var_color passifs.0 passifs.1 'total_III' %}">{% var passifs.0 passifs.1 'total_III' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>
    		    </tbody>
          </table>

          <div class="row">
            <div class="col col-sm-4"><h5><strong>{% trans "TRESORERIE PASSIF" %}</strong></h5></div>
          </div><br>
          <table class="table_bilan">
         	  <thead>
              <tr>
                <th  style="width: 32%;"></th>
                {% for a in passifs %}<th style="width: 17%">FY {{ a.annee }}</th>{% if forloop.counter == 2 %}<th style="width: 17%">VAR</th>{% endif %}{% endfor %}
		    	    </tr>
         	  </thead>
    		    <tbody>
              {% autoescape off %}
		    	      {% tab passifs 'banques_credit_escompte' 'banques_decouvert' %}
              {% endautoescape%}
              <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%" >TOTAL IV</td>
                {% for p in passifs %}
                  {% if p %}
		    		        <td width="15%">{{p.total_IV|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%"  style=" color: {% var_color passifs.0 passifs.1 'total_IV' %}">{% var passifs.0 passifs.1 'total_IV' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>

              {% autoescape off %}
		    	      {% tab passifs 'ecart_conversion_passif' 'ecart_conversion_passif' %}
              {% endautoescape%}

              <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%" >{% trans "TOTAL GENERAL" %}</td>
                {% for p in passifs %}
                  {% if p %}
		    		        <td width="15%">{{p.total_general|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%" style=" color: {% var_color passifs.0 passifs.1 'total_general' %}">{% var passifs.0 passifs.1 'total_general' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>
    		    </tbody>
          </table>
        </div>
        <br>
      {% endif %}

      {% if resultats.0 %}
        <div class="row mt-2" style="background-color: #000066; color: white;border-radius: 10px;">
          <div class="col-12 text-center">
            <h3><strong>{% trans "COMPTE DE RESULTAT" %}</strong></h3>
          </div>
        </div>
        <br>

        <div style="border: 1px solid #e4c010; border-radius:10px"><br>

          <table class="table_bilan">
         	  <thead>
              <tr>
                <th  style="width: 32%;"></th>
                {% for a in resultats %}<th style="width: 17%">FY {{ a.annee }}</th>{% if forloop.counter == 2 %}<th style="width: 17%">VAR</th>{% endif %}{% endfor %}
              </tr>
         	  </thead>
    		    <tbody>
		    	    <div >
		    		    <h5>{% trans "EXPLOITATION" %}</h5>
		    	    </div>
		    	    <tr>
					      <td width="40%"><b>{% trans "Produits d'exploitation" %}</b></td>
		    	    </tr>

              {% autoescape off %}
		    	      {% tab resultats 'vente_de_mdses' 'production_imblise' %}
              {% endautoescape%}

              <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%" >CA</td>
                {% for r in resultats %}
                  {% if r %}
		    		        <td width="15%">{{r.ca|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%"  style=" color: {% var_color resultats.0 resultats.1 'ca' %}">{% var resultats.0 resultats.1 'ca' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>

              {% autoescape off %}
		    	      {% tab resultats 'subventions_exploitations' 'autres_produits' %}
              {% endautoescape%}

              <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%" >TOTAL I</td>
                {% for r in resultats %}
                  {% if r %}
		    		        <td width="15%">{{r.total_I|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%"  style=" color: {% var_color resultats.0 resultats.1 'total_I' %}">{% var resultats.0 resultats.1 'total_I' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>

              {% autoescape off %}
		    	      {% tab resultats 'achat_mdses' 'variation_stock_mdses' %}
              {% endautoescape%}

              <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%" >{% trans "MARGE BRUT" %}</td>
                {% for r in resultats %}
                  {% if r %}
		    		        <td width="15%">{{r.marge_brute|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%" style=" color: {% var_color resultats.0 resultats.1 'marge_brute' %}">{% var resultats.0 resultats.1 'marge_brute' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>
    		    </tbody>
          </table>
          <table class="table_bilan">
            <thead>
              <tr>
                <th  style="width: 32%;"></th>
                {% for a in resultats %}<th style="width: 17%">FY {{ a.annee }}</th>{% if forloop.counter == 2 %}<th style="width: 17%">VAR</th>{% endif %}{% endfor %}
              </tr>
         	  </thead>
            <tbody>
              {% autoescape off %}
		    	      {% tab resultats 'achat_mp_autres_appro' 'autres_charges_valeur_ajoutee' %}
              {% endautoescape%}

              <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%" >{% trans "VALEUR AJOUTÉE" %}</td>
                {% for r in resultats %}
                  {% if r %}
		    		        <td width="15%">{{r.valeur_ajoutee|floatformat:"2"|intcomma}}</td>
                  {% else %}
                    <td width="15%">0</td>
                  {% endif %}
                  {% if forloop.counter == 2 %}
		    		        <td width="15%"  style=" color: {% var_color resultats.0 resultats.1 'valeur_ajoutee' %}">{% var resultats.0 resultats.1 'valeur_ajoutee' %} %</td>
                  {% endif %}
                {% endfor %}
		    	    </tr>
              {% autoescape off %}
