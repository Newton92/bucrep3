            <h3><strong>{% trans "RISQUE PAYS" %}</strong></h3>
          </div>
        </div>
        <br>
        <div style="border: 1px solid #e4c010; border-radius:10px">

        <div class="col" style="text-align: justify; text-justify: inter-word;">

              <b style="color:#e3c111; width:16%" >{% trans "Données politiques" %} : </b><br/>
              <span style="color:; text-align: justify; text-justify: inter-word;">

                {% autoescape off %}
                  {% traduit geopo.donnees_politiques|default_if_none:""|linebreaksbr  %}
                {% endautoescape %}
              </span>

        </div>


            <div class="col" style="text-align: justify; text-justify: inter-word;" >
              <b style="color:#e3c111; width:16%" >{% trans "Indicateurs politiques" %} : </b><br/>


                <table class="std100" id="indic">
                  <tbody>
                    <tr style="">
                      <td >{% trans "Stabilité politique" %}: </td>
                      <td class="contenu" style="height: 20px;"><div class="indibar"></div><div class="indidot" style="left:{{ stabilite_eco}}%;">◈</div></td>
                    </tr>
                    <tr>
                      <td>{% trans "Etat de droit" %}:</td>
                      <td><div class="indibar"></div><div class="indidot" style="left:{{etat_droit}}%;">◈</div></td>
                    </tr>
                    <tr>
                      <td>{% trans "Efficacité" %}:</td>
                      <td><div class="indibar"></div><div class="indidot" style="left:{{ efficacite}}%;">◈</div></td>
                    </tr>

                    <tr>
                      <td>{% trans "Qualité réglementaire" %}:</td>
                      <td><div class="indibar"></div><div class="indidot" style="left:{{ qualite}}%;">◈</div></td>
                    </tr>
                    <tr>
                      <td>{% trans "Liberté d'expression" %}:</td>
                      <td style="width: 70%"><div class="indibar"></div><div class="indidot" style="left:{{ liberte_expression}}%;">◈</div></td>
                    </tr>

                </tbody>
            </table>
          </div>

          <div class="col" style="text-align: justify; text-justify: inter-word;" >
                <b style="color:#e3c111; width:16%" >{% trans "Données économiques" %} : </b><br/>
                <span style="color:; text-align: justify; text-justify: inter-word;">
                  {% autoescape off %}
                    {% traduit geopo.donnees_economiques|default_if_none:""|linebreaksbr  %}
                  {% endautoescape %}
                </span>
          </div>

        </div>
        {% endfor %}




      <div class="row mt-2" style="background-color: #000066; color: white;border-radius: 10px;">
