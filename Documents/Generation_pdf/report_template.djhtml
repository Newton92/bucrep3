      <div class="row mt-2" style="background-color: #000066; color: white;border-radius: 10px;">
        <div class="col-12 text-center">
          <h3><strong>SCORE@ACREMAC</strong></h3>
        </div>
      </div><br>
      <div style="border: 1px solid #e4c010; border-radius:10px"><br>

        <div class="col col-sm-12">
          <table>
            <tr>
              <td style="width:100%;text-align: justify; text-justify: inter-word;">
                <p style="text-align: justify;" style="text-justify: inter-word;">
                              {% trans "Ce score est généré automatiquement par bucrep à travers les sommations des éléments suivants :Le site locaux, l'âge de l'entreprise, le comportement de paiement, l'opinion commerciale, le code Nace. Les éléments de la grille de score ont été pondérés en fonction de leur degré d'importance dans le calcul du risque. Cote de crédit :"%}
                </p>
                <p style="color:#5ab152"> {% trans "10- Sans risque" %}</p>
                <p style="color:#7bc175"> {% trans "9- Risque très faible" %}</p>
                <p style="color:#9cd097"> {% trans "8- Risque faible" %}</p>
                <p style="color:#add8a9"> {% trans "7- Risque modéré" %}</p>
                <p style="color:#cee8cb"> {% trans "6- Risque acceptable" %}</p>
                <p style="color:#f19545"> {% trans "5- Risque moyennement élevé" %}</p>
                <p style="color:#f7c033"> {% trans "4- Risque significatif" %}</p>
                <p style="color:#f6bd8a"> {% trans "3- Risque important" %}</p>
                <p style="color:#e93f33"> {% trans "2- Risque très important d'insolvabilité" %}</p>
                <p style=""> {% trans "1- Risque extrêmement important d'insolvabilité" %}</p>
                <p style=""> {% trans "0- Insolvabilité/Procédures de recouvrement" %}</p>


              </td>
            </tr>

            <tr>
              <td style="width:100%;text-align: justify; text-justify: inter-word;" >
              </td>
            </tr>

          </table>

        </div>


        {% if annee %}
          {% if annee_nn %}
            <div style=" background-color: #000066; width: 30%;text-align:center; color: white">{% trans "SCORE AUTOMATIQUE" %} {{annee}}</div>
            <img src="https://backendbucrep.acremac.net/static/scoring_automatique/{{scoring_automatique.0 |floatformat:'0' }}.png" style="width: 100%; height: auto;" />
          {% endif %}

          {% if annee_nn_moins_un %}
            <div style=" background-color: #000066; width: 30%;text-align:center; color: white">{% trans "SCORE AUTOMATIQUE" %} {{annee|add:"-1"}}</div>
            <img src="https://backendbucrep.acremac.net/static/scoring_automatique/{{scoring_automatique.1 |floatformat:'0' }}.png" style="width: 100%; height: auto;" />
          {% endif %}

          {% if annee_nn_moins_deux %}
            <div style=" background-color: #000066; width: 30%;text-align:center; color: white">{% trans "SCORE AUTOMATIQUE" %} {{annee|add:"-2"}}</div>
            <img src="https://backendbucrep.acremac.net/static/scoring_automatique/{{scoring_automatique.2 |floatformat:'0' }}.png" style="width: 100%; height: auto;" />
          {% endif %}
        {% endif %}


       <br>
      </div>




      {% if sans_etat_fin %}
        <div style=" background-color: #000066; width: 30%;text-align:center; color: white">{% trans "SCORE AUTOMATIQUE" %}</div>
        <img src="https://backendbucrep.acremac.net/static/scoring_automatique/{{scoring_automatique.0 |floatformat:'0' }}.png" style="width: 100%; height: auto;" />
      {% endif %}





    {% if scoring_manuel %}
    <br>
    <div style="border: 1px solid #e4c010; border-radius:10px"><br>

        {% for score in scoring_manuel %}

          {% if score.score %}
            <div style=" background-color: #000066; width: 30%;text-align:center; color: white">{% trans "SCORE MANUEL" %} {{score.annee}}</div>
            <img src="https://backendbucrep.acremac.net/static/scoring_automatique/{{score.score |floatformat:'0' }}.png" style="width: 100%; height: auto;" />
          {% endif %}


          {% if score.commentaire != '' %}
            <div>
              <p style="text-align: justify;" style="text-justify: inter-word;">
                <strong style="color:#e3c111">{% trans "Commentaire" %}:</strong>
                <div style="text-align: justify; text-justify: inter-word;">
                   {% autoescape off %}
                    {% traduit score.commentaire|default_if_none:""|linebreaksbr %}
                   {% endautoescape %}
                 </div>
              </p>
            </div>
          {% endif %}

         {% endfor %}
         </div>

    {% endif %}




















