{% load static %}
{% load report_extras %}
{% load qr_code %}
{% load i18n %}

{% load humanize %}

<html></html>
<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta
      0me="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="{% static 'bootstrap/dist/css/bootstrap.min.css' %}">
    <link rel="stylesheet" href="{% static 'bootstrap/dist/css/bootstrap.min.css' %}">
    <link rel="stylesheet" href="{% static 'font-awesome/css/font-awesome.min.css' %}">
    <link rel="stylesheet" href="{% static 'nprogress/nprogress.css' %}">
    <link rel="stylesheet" href="{% static 'iCheck/skins/flat/green.css' %}">
    <link rel="stylesheet" href="{% static 'bootstrap-progressbar/css/bootstrap-progressbar-3.3.4.min.css' %}">
    <link rel="stylesheet" href="{% static 'google-code-prettify/bin/prettify.min.css' %}">
    <link rel="stylesheet" href="{% static 'select2/dist/css/select2.min.css' %}">
    <link rel="stylesheet" href="{% static 'switchery/dist/switchery.min.css' %}">
    <link rel="stylesheet" href="{% static 'starrr/dist/starrr.css' %}">


    <link rel="stylesheet" href="{% static 'jqvmap/dist/jqvmap.min.css' %}">
    <link rel="stylesheet" href="{% static 'bootstrap-daterangepicker/daterangepicker.css' %}">


    <link rel="stylesheet" href="{% static 'datatables.net-bs/css/dataTables.bootstrap.min.css' %}">
    <link rel="stylesheet" href="{% static 'datatables.net-buttons-bs/css/buttons.bootstrap.min.css' %}">
    <link rel="stylesheet" href="{% static 'datatables.net-fixedheader-bs/css/fixedHeader.bootstrap.min.css' %}">
    <link rel="stylesheet" href="{% static 'datatables.net-responsive-bs/css/responsive.bootstrap.min.css' %}">
    <link rel="stylesheet" href="{% static 'datatables.net-scroller-bs/css/scroller.bootstrap.min.css' %}">
    <link
      rel="stylesheet"
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css"
      integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh"
      crossorigin="anonymous"
    />

    <script
      src="https://code.jquery.com/jquery-2.2.4.js"
      integrity="sha256-iT6Q9iMJYuQiMWNd9lDyBUStIq/8PuOW33aOqmvFpqI="
      crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>


    <title>BUCREP RAPPORT PDF</title>

    <style>

    /* styles.css */
@font-face {
  font-family: "AppSans";
  src: url("templates/fonts/DejaVuSans.ttf") format("truetype"); /* ou OTF/WOFF/WOFF2 */
  font-weight: 400;
  font-style: normal;
}
@font-face {
  font-family: "AppSans";
  src: url("fonts/DejaVuSans-Bold.ttf") format("truetype");
  font-weight: 700;
  font-style: bold;
}
html, body { font-family: "AppSans", sans-serif; }

/* Conseillé pour stabiliser les chiffres */
:root { font-variant-numeric: lining-nums tabular-nums; }


  .container{
   background: url("https://backendbucrep.acremac.net/static/img/FILIGRANE.png");



   /*background-repeat: repeat;*/
   vertical-align: middle;
   //background: #958A8A

     }
	   table  {
	 	   width: 100%;
	 	   line-height: normal;
	   }

	   .table_bilan td{
	 	   padding-right: 10px;
	 	   line-height: 2;
            left: 10px;
            margin:2px;

	   }
	   strong{
	 	   margin-left: 15px;
	   }

	   h5{
	 	   text-decoration: underline;
	 	   margin-left: 0px;
	 	   font-style: bold;
	 	   font-size: 16px;
	 	   margin-top: 15px;
	 	   font-weight: 600;
	   }
	   b{
	   font-style: bold;
	   }

     h3{
	     font-size: 19px;
	     padding: 5px;
     }
	   td {
	 	   vertical-align: top;
	   }

     /*Risk Rating*/

	   /* Float four columns side by side */
     .column {
       float: left;
       width: 100%;
       padding: 0 10px;
       background:red;
     }

     /* Remove extra left and right margins, due to padding */
     .row {margin: 0 -5px;}

     /* Clear floats after the columns */
     .row:after {
       content: "";
       display: table;
       clear: both;
     }



     /* Responsive columns */
     @media screen and (max-width: 60px) {
       .column {
         width: 100%;
         display: block;
         margin-bottom: 20px;
       }
     }

     /* Style the counter cards */
     .card {
	     margin-top: 30px;
	     margin-bottom: 30px;
       box-shadow: 0 4px 8px 0 rgba(0, 0, 0, 0.2);
       padding: 16px;
       text-align: center;
       background-color: #f1f1f1;

     }

     .contenu {
	     text-align:right;
     }


     #indic tr{height:22px;}#indic tr td:first-of-type{width:170px;}




    .indibar,.indidot{position:relative;display:block;box-sizing:border-box;}
    .indibar{
      top:4px;border-radius:2px;height:12px;width:100%;background-image:linear-gradient(to right, #860000, #9A9203, #06572B);
      background-image:-webkit-linear-gradient(left, #860000, #9A9203, #06572B);
    }
    .indidot{margin-top:-11px;width:10%;color:#blue;text-shadow:1px 1px 1px #333;text-align:center;font-size:20px;}



    .std100 tr>*{text-align:left;}.std100 tr>*:last-of-type{text-align:right;}

     h1{font-weight: 800; line-height: 50px; }

     @page {


       @top-left {
         content: url("https://backendbucrep.acremac.net/static/img/header.png") ;
         margin-left:-80px;
         margin-bottom:15px
       }

       @top-center {
       }

       /* @top-right{
          content: "{{entete_text|default_if_none:""}}  {{entete_text2|default_if_none:""}}";
          margin-left:-80px;
          margin-bottom:15px
          }*/




       @bottom-left {
	       content: url("https://backendbucrep.acremac.net/static/img/footer_top.png");
         margin-top :-30px

       }

       @bottom-right {


       }
       @bottom-center {
    	   width:20%;
         content: "Page " counter(page) " sur " counter(pages);
         color:#3c285e
       }

     }

     table.fixed-table
     {
       width:100%;
       table-layout:fixed;
     }

     table.fixed-table td
     {
       /* white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;*/
     }

    </style>

  </head>



  <body style="">
    <div class="container">
      <div class="row mt-4">
        <div class="col-12 text-center mb-4">
          <img src="https://backendbucrep.acremac.net/static/img/Logo-acremac.jpg" alt="" style="width: 250px" />
          {% qr_from_text url_qr size=2 image_format='png' %}
        </div>
      </div>
		  <p id="grouped" width="400" height="225"></p>


      <p class="" style="text-align:right; font-size: 11px">
        © ACREMAC Services {{ acheteur.ville.pays }}<br />
        email : <a href="mailto:credit.report@acremac.com">credit.report@acremac.com</a><br />
        {% now 'l j Y H:i' %} (GMT)
      </p>

      <div class="row mt-2" style="background-color: #000066; color: white;border-radius: 10px;">
        <div class="col-12 text-center">
          <h1 style="font-family: ;"> {% trans "RAPPORT DE SOLVABILITE" %}</h1>
        </div>
      </div>


      <br/>

      {% if commande %}
      <div  style="border: 1px solid #e4c010; border-radius:10px">

        <table class="fixed-table">
          <tr style="width:100%">
            <td style="width:20%" class="contenu"  valign="center"><b>{% trans "Nom du client" %} :</b></td>
            <td style="width:30%" valign="center">
                {% if commande.type_commande == "NORMALE"%}
                    {{ commande.client.first_name|default_if_none:"" }}
                {% else %}
                     {{ commande.client_nom|default_if_none:"" }}
                {% endif %}
            </td>

            <td style="width:30%" class="contenu"  valign="center"><b>{% trans "Date réception demande" %} :</b></td>
            <td style="width:30%"  valign="center">
              {{ commande.date_recept_commande|default_if_none:"" }}
            </td>
          </tr>

          <tr>

            <td style="width:20%"  class="contenu"><b>{% trans "Référence client" %} :</b></td>
            <td style="width:30%" >
              {{ commande.reference_client|default_if_none:""}}
            </td>

            <td style="width:20%"  class="contenu"><b>{% trans "Date du rapport" %} :</b></td>
            <td style="width:30%">
               {{ commande.date_rapport|default_if_none:""}}
            </td>

          </tr>

          <tr>
            <td style="width:20%" class="contenu"><b>{% trans "Notre référence" %} :</b></td>
            <td style="width:30%">
              {{ commande.notre_ref|default_if_none:""}}
            </td>

            {% if commande.delais is not None %}
              <td style="width:20%" class="contenu"><b>{% trans "Délais en jour" %} :</b></td>
              <td style="width:30%">
                {{ commande.delais}}
              </td>
            {% endif %}
            </tr>



             {% if commande.client.first_name == "ALLIANZ TRADE"%}

                    <tr>
                        <td style="width:20%" class="contenu"><b>{% trans "CIN" %} :</b></td>
                        <td style="width:30%">
                          {{ commande.company_identification_number|default_if_none:""}}
                        </td>

                        <td style="width:20%" class="contenu"><b>{% trans "Address Additional" %} :</b></td>
                        <td style="width:30%">
                          {{ commande.address_additional|default_if_none:""}}
                        </td>
                    </tr>

                    <tr>
                        <td style="width:20%" class="contenu"><b>{% trans "State" %} :</b></td>
                        <td style="width:30%">
                          {{ commande.state|default_if_none:""}}
                        </td>

                        <td style="width:20%" class="contenu"><b>{% trans "Postcode" %} :</b></td>
                        <td style="width:30%">
                          {{ commande.postcode|default_if_none:""}}
                        </td>
                    </tr>

                    <tr>
                        <td style="width:20%" class="contenu"><b>{% trans "Post office" %} :</b></td>
                        <td style="width:30%">
                          {{ commande.post_office|default_if_none:""}}
                        </td>

                        <td style="width:20%" class="contenu"><b>{% trans "Provider" %} :</b></td>
                        <td style="width:30%">
                          {{ commande.provider|default_if_none:""}}
                        </td>
                    </tr>

                    <tr>
                        {% if commande.type_rapport is not None %}
                              <td width="25%" class="contenu"> <b>{% trans "Type de rapport" %} :</b></td>
                              <td width="30%">
                                {{ commande.type_rapport}}
                              </td>
                        {% endif %}

                        <td style="width:20%" class="contenu"><b>{% trans "Comments" %} :</b></td>
                        <td style="width:30%">
                          {{ commande.comments|default_if_none:""}}
                        </td>


                    </tr>



             {% endif %}
















        </table>
      </div>

      {% endif %}
      <br>














      <div class="row mt-2" style="background-color: #000066; color: white;border-radius: 10px;">
        <div class="col-12 text-center">
          <h3><strong>{% trans "IDENTIFICATION" %}</strong></h3>
        </div>
      </div>

      <br>

            <div  style="border: 1px solid #e4c010; border-radius:10px">

        {% if commande != None %}

          <div class="">
            <div class="row">
              <div class="col col-sm-12" style="margin-top: 10px"><h5><strong>{% trans "DONNEES DU CLIENT" %}</strong></h5></div>
            </div>
          </div>

          <table>
              <tr>
                <td style=" width: 30%" class="contenu"><b>{% trans "Raison sociale" %} :</b></td>
                <td style=" width: 70%">
                  {{ commande.raison_sociale}}
                </td>
              </tr>

              <tr>
                <td width="10%" class="contenu"><b>{% trans "Adresse" %} :</b> </td>
                <td width="40%">
                  {{ commande.numero_adresse|default_if_none:""}}
                    {{ commande.rue_adresse|default_if_none:""}} {{ commande.code_postale_adresse|default_if_none:""}}
                </td>
              </tr>


              <tr>
                <td width="15%" class="contenu"><b>{% trans "Ville" %} :</b></td>
                <td width="35%">
                  {{ commande.ville|default_if_none:""}}
                </td>
              </tr>


              <tr>
                <td width="10%" class="contenu"><b>{% trans "Pays" %} :</b></td>
                <td width="40%">
                  {{ commande.ville.pays |default_if_none:""}}
                </td>
              </tr>

              <tr>
                <td width="10%" class="contenu"><b>{% trans "Téléphone" %} :</b></td>
                <td width="40%">
                  {{ commande.telephone |default_if_none:""}}
                </td>
              </tr>


              <tr>
                <td width="10%" class="contenu"><b>{% trans "Email" %} :</b></td>
                <td width="40%">
                  {{ commande.email |default_if_none:""}}
                </td>
              </tr>
            {% endif %}
          </table>
          <br>



        <div class="">
          <div class="row">
            <div class="col col-sm-12"><h5><b>{% trans "DONNEES ACREMAC" %}</b></h5></div>
          </div>
        </div>

        <table>

            <tr>
              <td style=" width: 30%" class="contenu"><b>{% trans "Raison sociale" %} :</b></td>
              <td style=" width: 70%">
                {{acheteur.nom}}
              </td>
            </tr>



            <tr>
              <td width="10%" class="contenu"><b>{% trans "Sigle" %} :</b></td>
              <td width="40%">
                {{acheteur.sigle|default_if_none:"" }}
              </td>
            </tr>

            <tr>
              <td width="10%" class="contenu"><b>{% trans "Numéro interne ACREMAC" %} :</b></td>
              <td width="40%">
                {{acheteur.id|default_if_none:"" }}
              </td>
            </tr>

            {% for tel in telephone_acheteur %}
                <tr>
                  <td width="15%" class="contenu"><b>{% trans "Téléphone" %} {{ forloop.counter }} :</b></td>
                  <td width="35%">
                    {{tel.telephone|default_if_none:""}}
                  </td>
                </tr>

            {% endfor %}




              <tr>
                <td width="15%" class="contenu"><b>{% trans "Adresse" %} : </b></td>
                <td width="35%">
                  {{ acheteur.numero_adresse|default_if_none:""}}
                    {{ acheteur.rue_adresse|default_if_none:""}} {{ acheteur.code_postale_adresse|default_if_none:""}}
                </td>
              </tr>


              <tr>
                <td width="10%" class="contenu"><b>{% trans "BP" %} :</b></td>
                <td width="40%">
                  {{acheteur.boite_postale|default_if_none:""}}
                </td>
              </tr>


              <tr>
                <td width="15%" class="contenu"><b>{% trans "Fax" %} :</b></td>
                <td width="35%">
                  {{ acheteur.fax|default_if_none:""}}
                </td>
              </tr>


              {% if acheteur.region %}
              <tr>
                <td width="10%" class="contenu"><b>Region :</b></td>
                <td width="40%">
                  {{ acheteur.region |default_if_none:""}}
                </td>
              </tr>
              {% endif %}

              <tr>
                <td width="10%" class="contenu"><b>{% trans "Ville" %} :</b></td>
                <td width="40%">
                  {{ acheteur.ville |default_if_none:""}}
                </td>
              </tr>


              <tr>
                <td width="15%" class="contenu"><b>{% trans "Site internet" %} : </b></td>
                <td width="35%">
                  {{ acheteur.site_internet |default_if_none:""}}
                </td>
              </tr>


              <tr>
                <td width="10%" class="contenu"><b>{% trans "Pays" %} :</b> </td>
                <td width="40%">
                  {{ acheteur.ville.pays |default_if_none:""}}
                </td>
              </tr>


              <tr>
                <td style="width:15%" class="contenu"><b>{% trans "Code NACE" %} :</b></td>
                <td style="width:75%">
                  {{ acheteur.code_nace|default_if_none:""}}
                </td>
              </tr>

            {% for port in portable_acheteur %}
                <tr>
                  <td width="15%" class="contenu"><b>{% trans "Portable" %} {{ forloop.counter }} :</b></td>
                  <td width="35%">
                    {{port.portable|default_if_none:""}}
                  </td>
                </tr>
            {% endfor %}


              {% for em in email_acheteur %}
                <tr>
                  <td width="15%" class="contenu"><b>{% trans "Email" %} {{ forloop.counter }} :</b></td>
                  <td width="35%">
                    {{em.email|default_if_none:""}}
                  </td>
                </tr>

            {% endfor %}


              <tr>
                <td style=" width: 15%" class="contenu"><b>{% trans "Activité principale" %} : </b></td>
                <td style=" width: 75%">
                  <span style="style="text-align: justify; text-justify: inter-word">

                    {% autoescape off %}
                        {%  traduit acheteur.activite_principale  %}
                    {% endautoescape %}

                  </span>
                </td>
              </tr>
        </table>

          <br>
          <div class="col">
            <div class="row">
              <div class="col col-sm-12">
                <b style="color:#e3c111; width:16%" >{% trans "Commentaire" %} :</b><br/>
                <span style="color:{{acheteur.couleur_commentaire.code }};text-align: justify; text-justify: inter-word; width: 20%;">
                  {% autoescape off %}
                    {%  traduit acheteur.commentaire|default_if_none:""|linebreaksbr %}
                  {% endautoescape %}
                </span>
              </div>
            </div>

          </div>

      </div>


       <br>
        <div class="row mt-2" style="background-color: #000066; color: white;border-radius: 10px;">
          <div class="col-12 text-center">
            <h3><b>{% trans "RÉSUMÉ" %}</b></h3>
          </div>
        </div>
        <br>

        {% with donnees_enregistrement=acheteur.donneesenregistrement_set.first %}
          {% with resume=acheteur.resume_set.first %}
        <div style="border: 1px solid #e4c010; border-radius:10px">
          <br>
          <table>


                <tr>
                  <td style=" width: 15%"  class="contenu"><b>{% trans "Date de création" %} :</b></td>
                  <td style=" width: 30%" >
                    {{resume.date_creation|default_if_none:""}}
                  </td>
                </tr>
                <tr>


               <tr>
                <td style=" width: 15%"  class="contenu"><b>{% trans "Capitaux propres" %} :</b></td>
                <td style=" width: 30%" >
                    {% if resume.capitaux_propre != None and resume.capitaux_propre != 0 %}
                        <span>{{resume.capitaux_propre|default_if_none:""|intcomma}}&nbsp;&nbsp;{{resume.devise.code|default_if_none:""}}</span>
                    {% endif %}
                </td>
                </tr>

                <tr>
                  <td width="15%" class="contenu para"><b>{% trans "Capital social" %} :</b></td>
                  <td width="35%">
                  {% if resume.capital_social != None or  resume.capital_social != 0 %}
                    <span>{{resume.capital_social|default_if_none:""|intcomma}}&nbsp;&nbsp; {{resume.devise.code|default_if_none:""}}</span>
                    {% endif %}
                  </td>
               <tr>


                <tr>
                  <td style=" width: 15%"  class="contenu"><b>{% trans "Nombre d'employés" %} :</b></td>
                    <td style=" width: 28%" >

                      <span>{{resume.nombre_employe|default_if_none:""|intcomma}}</span>
                    </td>
                </tr>


                <tr>
                  <td width="15%" class="contenu"><b>{% trans "Chiffre d'affaires" %} :</b></td>
                   <td width="35%">
                    {% if resume.chiffre_affaire != None and resume.chiffre_affaire != 0 %}
                        <span>{{resume.chiffre_affaire|default_if_none:""|intcomma}}&nbsp;&nbsp;{{resume.devise.code|default_if_none:""}}</span>
                    {% endif %}
                  </td>
                </tr>


                <tr>
                  <td width="15%" class="contenu"><b>{% trans "Résultat Net" %} :</b></td>
                  <td width="35%">
                    {% if resume.resultat_net != None and resume.resultat_net != 0 %}
                        <span>{{resume.resultat_net|default_if_none:""|intcomma}}&nbsp;&nbsp;{{resume.devise.code|default_if_none:""}}</span>
                    {% endif %}
                  </td>
                </tr>


              <tr>
                <td style=" width: 15%"  class="contenu"><b>{% trans "Forme Juridique" %} :</b></td>
                <td style=" width: 33%" >
                  <span>{{donnees_enregistrement.forme_juridique|default_if_none:""}}</span>
                </td>
              </tr>

          </table>
            <br>
            <div class="col">
              <div class="row">
                <div class="col col-sm-12">
                  <b style="color:#e3c111; width:16%" >{% trans "Commentaire" %} :</b><br/>
                  <div style="text-align: justify; text-justify: inter-word;color:{{resume.couleur_commentaire.code }}; ">

                  {% autoescape off %}
                    {% traduit resume.commentaire|default_if_none:""|linebreaksbr %}
                  {% endautoescape %}

                  </div>
                </div>
              </div>
            </div>

        </div>
        {% endwith %}
        {% endwith %}
        <br>



    <br>

          <div class="row mt-2" style="background-color: #000066; color: white;border-radius: 10px;">
            <div class="col-12 text-center">
              <h3><strong>{% trans "RISK RATING" %}</strong></h3>
            </div>
          </div>
          <br>

          <div style="border: 1px solid #e4c010; border-radius:10px">


            <div class="col col-sm-12 col-md-12">

                <div class="row">
                  <div class="col col-sm-12">
                    <center>
                      <img src="https://backendbucrep.acremac.net/static/images/{{numRisk}}.svg" alt="" class="summary" style="width: 400px"/>
                      <center/>
                  </div>
                </div>


                <div class="row" width="100%">
                  <div >
                    <b style="color:#e3c111; margin-top: 30px;text-align: justify;" style="text-justify: inter-word;">{% trans "Analyse" %} :</b>
                    <p style="text-align: justify;" style="text-justify: inter-word;">

                    {% autoescape off %}
                      {% traduit riskrating.analyse|linebreaksbr|default_if_none:"" %}
                    {% endautoescape %}
                    </p>
                  </div>
                </div>

                <div class="row" width="100%">
                  <div >
                    <b style="color:#e3c111; margin-top: 30px">{% trans "Interprétation" %} :</b>
                    <p style="text-align: justify;" style="text-justify: inter-word;">
                    {% autoescape off %}
                      {% traduit riskrating.interpretation|linebreaksbr|default_if_none:"" %}
