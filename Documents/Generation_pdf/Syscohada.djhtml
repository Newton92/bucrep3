{% load static %}
{% load report_extras %}
{% load qr_code %}
{% load i18n %}

{% load humanize %}


{% if annee %}
      {% if actifsys.0 %}
        <div class="row mt-2" style="background-color: #000066; color: white;border-radius: 10px;">
          <div class="col-12 text-center">
            <h3><strong>{% trans "ACTIF" %}</strong></h3>
          </div>
        </div><br>
        <div style="border: 1px solid #e4c010; border-radius:10px"><br>
          <table class="table_bilan">
         	  <thead>
         	    <tr>
                <th  style="width: 32%;"></th>
                {% for a in actifsys %}<th style="width: 17%">FY {{ a.annee }}</th>{% if forloop.counter == 2 %}<th style="width: 17%">VAR</th>{% endif %}{% endfor %}
		    	    </tr>
         	  </thead>
    		    <tbody>
    			     <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px">{% trans "IMMOBILISATIONS INCORPORELLES" %}</td>
                        {% for a in actifsys %}
                          {% if a %}
                                    <td width="15%">{{a.immobilisation_incorporelles|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var actifsys.0 actifsys.1 'immobilisation_incorporelles' %}</td>
                          {% endif %}
                        {% endfor %}
                     </tr>
                {% autoescape off %}
		    	      {% tab actifsys 'frais_developpement_prospection' 'autres_immo_incorporelles' %}
                {% endautoescape%}

                <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px"> {% trans "IMMOBILISATIONS CORPORELLES" %}</td>
                        {% for a in actifsys %}
                          {% if a %}
                                    <td width="15%">{{a.immobilisations_corporelles|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var actifsys.0 actifsys.1 'immobilisations_corporelles' %}</td>
                          {% endif %}
                        {% endfor %}
                </tr>

                {% autoescape off %}
		    	      {% tab actifsys 'terrains' 'materiel_transport' %}
                {% endautoescape%}

                <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px"> {% trans "AVANCES ET ACOMPTES SUR IMMOBILISATIONS" %}</td>
                        {% for a in actifsys %}
                          {% if a %}
                                    <td width="15%">{{a.avances_acompte_immobilisations|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var actifsys.0 actifsys.1 'avances_acompte_immobilisations' %}</td>
                          {% endif %}
                        {% endfor %}
                </tr>

                {% autoescape off %}
		    	      {% tab actifsys 'titres_participation' 'autres_immobilisations_financieres' %}
                {% endautoescape%}

               <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
                    <td width="40%"   style="font-size:14px"> {% trans "TOTAL DE L'ACTIF IMMOBILISÉ" %}</td>
                    {% for a in actifsys %}
                      {% if a %}
                                <td width="15%">{{a.total_actif_immobilise|floatformat:"2"|intcomma}}</td>
                      {% else %}
                        <td width="15%">0</td>
                      {% endif %}
                      {% if forloop.counter == 2 %}
                                <td width="15%">{% var actifsys.0 actifsys.1 'total_actif_immobilise' %}</td>
                      {% endif %}
                    {% endfor %}
                </tr>

               {% autoescape off %}
		    	      {% tab actifsys 'actif_circulant_hao' 'stock_encours' %}
               {% endautoescape%}

              <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
                    <td width="40%"   style="font-size:14px"> {% trans "CRÉANCES ET EMPLOIS SIMILAIRES" %}</td>
                    {% for a in actifsys %}
                      {% if a %}
                                <td width="15%">{{a.creances_emplois_similaires|floatformat:"2"|intcomma}}</td>
                      {% else %}
                        <td width="15%">0</td>
                      {% endif %}
                      {% if forloop.counter == 2 %}
                                <td width="15%">{% var actifsys.0 actifsys.1 'creances_emplois_similaires' %}</td>
                      {% endif %}
                    {% endfor %}
              </tr>

               {% autoescape off %}
		    	      {% tab actifsys 'fournisseurs_avances_versee' 'autres_creances' %}
               {% endautoescape%}

              <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
                    <td width="40%"   style="font-size:14px"> {% trans "TOTAL DE L'ACTIF CIRCULANT" %}</td>
                    {% for a in actifsys %}
                      {% if a %}
                                <td width="15%">{{a.total_actif_immobilise|floatformat:"2"|intcomma}}</td>
                      {% else %}
                        <td width="15%">0</td>
                      {% endif %}
                      {% if forloop.counter == 2 %}
                                <td width="15%">{% var actifsys.0 actifsys.1 'total_actif_immobilise' %}</td>
                      {% endif %}
                    {% endfor %}
              </tr>

               {% autoescape off %}
		    	      {% tab actifsys 'valeurs_mobilieres_placement' 'banque_cheque_postal_caisse_assimiles' %}
               {% endautoescape%}

              <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
                    <td width="40%"   style="font-size:14px"> {% trans "TOTAL DE LA TRÉSORERIE ET DES ÉQUIVALENTS DE TRÉSORERIE" %}</td>
                    {% for a in actifsys %}
                      {% if a %}
                                <td width="15%">{{a.total_tresorerie_equivalents|floatformat:"2"|intcomma}}</td>
                      {% else %}
                        <td width="15%">0</td>
                      {% endif %}
                      {% if forloop.counter == 2 %}
                                <td width="15%">{% var actifsys.0 actifsys.1 'total_tresorerie_equivalents' %}</td>
                      {% endif %}
                    {% endfor %}
              </tr>

              {% autoescape off %}
		    	      {% tab actifsys 'ecart_conversion_actif' 'ecart_conversion_actif' %}
              {% endautoescape%}

              <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
                    <td width="40%"   style="font-size:14px"> {% trans "TOTAL ACTIF" %}</td>
                    {% for a in actifsys %}
                      {% if a %}
                                <td width="15%">{{a.total_actif|floatformat:"2"|intcomma}}</td>
                      {% else %}
                        <td width="15%">0</td>
                      {% endif %}
                      {% if forloop.counter == 2 %}
                                <td width="15%">{% var actifsys.0 actifsys.1 'total_actif' %}</td>
                      {% endif %}
                    {% endfor %}
              </tr>
    		    </tbody>
          </table>


           </div>
      {% endif %}

      {% if passifsys.0 %}
        <div class="row mt-2" style="background-color: #000066; color: white;border-radius: 10px;">
          <div class="col-12 text-center">
            <h3><strong>{% trans "PASSIF" %}</strong></h3>
          </div>
        </div> <br>

        <div style="border: 1px solid #e4c010; border-radius:10px"><br>
          <table class="table_bilan">
         	  <thead>
         	    <tr>
                <th  style="width: 32%;"></th>
                {% for a in passifsys %}<th style="width: 17%">FY {{ a.annee }}</th>{% if forloop.counter == 2 %}<th style="width: 17%">VAR</th>{% endif %}{% endfor %}
		    	    </tr>
         	  </thead>
    		    <tbody>
                    {% autoescape off %}
                          {% tab passifsys 'capital' 'provisions_reglees' %}
                    {% endautoescape%}

                    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px">{% trans "TOTAL DES CAPITAUX PROPRES ET RESSOURCES SIMILAIRES" %}</td>
                        {% for a in passifsys %}
                          {% if a %}
                                    <td width="15%">{{a.total_capitaux_propres_ressources_similaires|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var passifsys.0 passifsys.1 'total_capitaux_propres_ressources_similaires' %}</td>
                          {% endif %}
                        {% endfor %}
                     </tr>

                    {% autoescape off %}
                          {% tab passifsys 'emprunts_dettes_financieres_diverse' 'provisions_risques_charges' %}
                    {% endautoescape%}

                    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px">{% trans "TOTAL DES DETTES FINANCIÈRES ET RESSOURCES ASSIMILÉES" %}</td>
                        {% for a in passifsys %}
                          {% if a %}
                                    <td width="15%">{{a.total_dettes_financieres_ressources_similaires|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var passifsys.0 passifsys.1 'total_dettes_financieres_ressources_similaires' %}</td>
                          {% endif %}
                        {% endfor %}
                    </tr>
                   <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px">{% trans "TOTAL DES RESSOURCES STABLES" %}</td>
                        {% for a in passifsys %}
                          {% if a %}
                                    <td width="15%">{{a.total_ressources_stables|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var passifsys.0 passifsys.1 'total_ressources_stables' %}</td>
                          {% endif %}
                        {% endfor %}
                     </tr>

                    {% autoescape off %}
                          {% tab passifsys 'passif_circulant_hao' 'provisions_risques_court_terme' %}
                    {% endautoescape%}

                   <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px">{% trans "TOTAL DES PASSIFS COURANTS" %}</td>
                        {% for a in passifsys %}
                          {% if a %}
                                    <td width="15%">{{a.total_passifs_courants|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var passifsys.0 passifsys.1 'total_passifs_courants' %}</td>
                          {% endif %}
                        {% endfor %}
                     </tr>

                    {% autoescape off %}
                          {% tab passifsys 'banques_credit_escompte' 'banques_etablissements_financiers_credit_caisse' %}
                    {% endautoescape%}


                    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px">{% trans "TOTAL DE LA TRÉSORERIE ET DES ÉQUIVALENTS DE TRÉSORERIE" %}</td>
                        {% for a in passifsys %}
                          {% if a %}
                                    <td width="15%">{{a.total_tresorerie_equivalents|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var passifsys.0 passifsys.1 'total_tresorerie_equivalents' %}</td>
                          {% endif %}
                        {% endfor %}
                     </tr>

                    {% autoescape off %}
                          {% tab passifsys 'ecart_conversion_passif' 'ecart_conversion_passif' %}
                    {% endautoescape%}

                    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px">{% trans "TOTAL DES PASSIFS" %}</td>
                        {% for a in passifsys %}
                          {% if a %}
                                    <td width="15%">{{a.total_passifs|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var passifsys.0 passifsys.1 'total_passifs' %}</td>
                          {% endif %}
                        {% endfor %}
                     </tr>


                </tbody>
               </table>
             </div>
        {% endif %}



      {% if resultatsys.0 %}
        <div class="row mt-2" style="background-color: #000066; color: white;border-radius: 10px;">
          <div class="col-12 text-center">
            <h3><strong>{% trans "COMPTE DE RESULTAT" %}</strong></h3>
          </div>
        </div> <br>

        <div style="border: 1px solid #e4c010; border-radius:10px"><br>
          <table class="table_bilan">
         	  <thead>
         	    <tr>
                <th  style="width: 32%;"></th>
                {% for a in resultatsys %}<th style="width: 17%">FY {{ a.annee }}</th>{% if forloop.counter == 2 %}<th style="width: 17%">VAR</th>{% endif %}{% endfor %}
		    	    </tr>
         	  </thead>
    		    <tbody>
                    {% autoescape off %}
                          {% tab resultatsys 'ventes_marchandises_a' 'variation_stock_marchandises' %}
                    {% endautoescape%}

                    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px">{% trans "MARGE COMMERCIALE (Somme TA à RB)" %}</td>
                        {% for a in resultatsys %}
                          {% if a %}
                                    <td width="15%">{{a.marge_commerciale|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var resultatsys.0 resultatsys.1 'marge_commerciale' %}</td>
                          {% endif %}
                        {% endfor %}
                     </tr>
                    {% autoescape off %}
                          {% tab resultatsys 'ventes_produits_manufactures' 'produits_accessoires_d' %}
                    {% endautoescape%}

                    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px">{% trans "CHIFFRE D'AFFAIRES (A+B+C+D)" %}</td>
                        {% for a in resultatsys %}
                          {% if a %}
                                    <td width="15%">{{a.chiffre_affaires|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var resultatsys.0 resultatsys.1 'chiffre_affaires' %}</td>
                          {% endif %}
                        {% endfor %}
                     </tr>
                    {% autoescape off %}
                          {% tab resultatsys 'production_stockee' 'autres_depenses' %}
                    {% endautoescape%}

                    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px">{% trans "VALEUR AJOUTÉE (XB+RA+RB) + (Somme TE à RJ)" %}</td>
                        {% for a in resultatsys %}
                          {% if a %}
                                    <td width="15%">{{a.valeur_ajoutee|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var resultatsys.0 resultatsys.1 'valeur_ajoutee' %}</td>
                          {% endif %}
                        {% endfor %}
                     </tr>

                    {% autoescape off %}
                          {% tab resultatsys 'frais_personnel' 'frais_personnel' %}
                    {% endautoescape%}

                    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px">{% trans "EXCÉDENT BRUT D'EXPLOITATION" %}</td>
                        {% for a in resultatsys %}
                          {% if a %}
                                    <td width="15%">{{a.excedent_brute_exploitation|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var resultatsys.0 resultatsys.1 'excedent_brute_exploitation' %}</td>
                          {% endif %}
                        {% endfor %}
                     </tr>

                    {% autoescape off %}
                          {% tab resultatsys 'reprise_depreciations_amortissements_provision_pertes_valeurs_p' 'reprise_depreciations_amortissements_provision_pertes_valeurs_m' %}
                    {% endautoescape%}


                    <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px">{% trans "RÉSULTAT D'EXPLOITATION (XD+TJ+RL)" %}</td>
                        {% for a in resultatsys %}
                          {% if a %}
                                    <td width="15%">{{a.resultat_exploitation|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var resultatsys.0 resultatsys.1 'resultat_exploitation' %}</td>
                          {% endif %}
                        {% endfor %}
                    </tr>

                    {% autoescape off %}
                          {% tab resultatsys 'produits_financiers_assimiles' 'dotations_provisions_depreciations_financieres' %}
                    {% endautoescape%}

                   <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px">{% trans "RÉSULTAT FINANCIER (Somme TK à RN)" %}</td>
                        {% for a in resultatsys %}
                          {% if a %}
                                    <td width="15%">{{a.resultat_financier|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var resultatsys.0 resultatsys.1 'resultat_financier' %}</td>
                          {% endif %}
                        {% endfor %}
                   </tr>

                   <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px">{% trans "RÉSULTAT DES ACTIVITÉS ORDINAIRES (XE+XF)" %}</td>
                        {% for a in resultatsys %}
                          {% if a %}
                                    <td width="15%">{{a.resultat_activites_ordinaires_xe|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var resultatsys.0 resultatsys.1 'resultat_activites_ordinaires_xe' %}</td>
                          {% endif %}
                        {% endfor %}
                   </tr>

                   {% autoescape off %}
                          {% tab resultatsys 'produits_cession_immobilisations' 'autres_charges_hao' %}
                   {% endautoescape%}

                   <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px">{% trans "RÉSULTATS DES ACTIVITÉS ORDINAIRES (Somme TN à RP)" %}</td>
                        {% for a in resultatsys %}
                          {% if a %}
                                    <td width="15%">{{a.resultat_activites_ordinaires_tn|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var resultatsys.0 resultatsys.1 'resultat_activites_ordinaires_tn' %}</td>
                          {% endif %}
                        {% endfor %}
                   </tr>

                   {% autoescape off %}
                          {% tab resultatsys 'participation_travailleurs' 'charge_impot_revenu' %}
                   {% endautoescape%}

                  <tr style="background-color: #e3c111 ; color : #000; font-weight: 700">
		    		    <td width="40%"   style="font-size:14px">{% trans "RÉSULTAT NET (XG+XH+RQ+RS)" %}</td>
                        {% for a in resultatsys %}
                          {% if a %}
                                    <td width="15%">{{a.resultat_net|floatformat:"2"|intcomma}}</td>
                          {% else %}
                            <td width="15%">0</td>
                          {% endif %}
                          {% if forloop.counter == 2 %}
                                    <td width="15%">{% var resultatsys.0 resultatsys.1 'resultat_net' %}</td>
                          {% endif %}
                        {% endfor %}
                   </tr>
                </tbody>
           </table>
         </div>





      <div class="row mt-2" style="background-color: #000066; color: white;border-radius: 10px;">
        <div class="col-12 text-center">
          <h3><strong>{% trans "RATIOS" %}</strong></h3>
        </div>
      </div> <br>
      <div style="border: 1px solid #e4c010; border-radius:10px"><br>
        <h5><strong>{% trans "STRUCTURE FINANCIERE" %}</strong></h5> <br>
        <table class="table_bilan">
         	<thead>
         	  <tr>
              <th  style="width: 32%;"></th>
              <th style="width: 17%;">FY {{annee}}</th>
              <th style="width: 17%;">FY {{annee|add:"-1"}}</th>
              <th style="width: 17%;">VAR</th>
              {% if annee_nn_moins_deux %}
                <th style="width: 17%;">FY {{annee|add:"-2"}}</th>
              {% endif %}
		    	  </tr>
         	</thead>
    	    <tbody>
                    <tr><td style="text-align: center"  colspan="5"><br></td></tr>
                    <tr><td style="text-align: center;background-color: #e3c111 "  colspan="5">{% trans "RATIOS DE FONDS DE ROULEMENT ET BESOINS EN FONDS DE ROULEMENT" %}</td></tr>
    			  <tr>
		    		  <td style="width: 32%;font-size:14px">{% trans "Fonds de roulement" %}</td>
		    		  <td style="font-size:14px" style="width: 17%;">{{ratiosys.fonds_de_roulement.0|floatformat:"2"|intcomma}}</td>
              <td style="font-size:14px" style="width: 17%;">{{ratiosys.fonds_de_roulement.1|floatformat:"2"|intcomma}}</td>
		    		  <td style="font-size:14px" style="width: 17%;">{{ratiosys.fonds_de_roulement.var| multiply:100|floatformat:"2"|intcomma}} %</td>
		    		  {% if annee_nn_moins_deux %}  <td style="font-size:14px" style="width: 17%;">{{ratiosys.fonds_de_roulement.2|floatformat:"2"|intcomma}} </td>{% endif %}
            </tr>
            
            <tr>
		    		  <td style="font-size:14px" width="40%">{% trans "Besoin en fonds de roulement" %}</td>
		    		  <td style="font-size:14px" width="15%">{{ratiosys.besoin_fonds_de_roulement.0|floatformat:"2"|intcomma}} </td>
		    		  <td style="font-size:14px" width="15%">{{ratiosys.besoin_fonds_de_roulement.1|floatformat:"2"|intcomma}} </td>
		    		  <td style="font-size:14px" width="15%">{{ratiosys.besoin_fonds_de_roulement.var| multiply:100|floatformat:"2"|intcomma}} %</td>
		    		  {% if annee_nn_moins_deux %}  <td style="font-size:14px" width="15%">{{ratiosys.besoin_fonds_de_roulement.2| floatformat:"2"|intcomma}} </td>{% endif %}
		    	  </tr>

                  <tr>
		    		  <td  style="font-size:14px"width="40%">{% trans "Position nette de trésorerie" %}</td>
		    		  <td  style="font-size:14px"width="15%">{{ratiosys.position_net_de_tresorerie.0|floatformat:"2"|intcomma}} </td>
