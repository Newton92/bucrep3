    {% if scoring_automatique %}

      <div class="row mt-2" style="background-color: #000066; color: white;border-radius: 10px;">
        <div class="col-12 text-center">
          <h3><strong>{% trans "SCORING" %}</strong></h3>
        </div>
      </div><br>
      <div style="border: 1px solid #e4c010; border-radius:10px"><br>

        <div class="col col-sm-12">
          <table>
            <tr>
              <td style="width:100%;text-align: justify; text-justify: inter-word;">
               {% trans "Ce score est généré automatiquement par bucrep à travers les sommations des éléments suivants :Le site locaux, l'âge de l'entreprise, le comportement de paiement, l'opinion commerciale, le code Nace. Les éléments de la grille de score ont été pondérés en fonction de leur degré d'importance dans le calcul du risque. Cote de crédit : 10 excellent, 9 Risque très faible, 8 Risque faible, 7 Risque modéré, 6 Risque acceptable, 5 Risque moyennement élevé, 4 Risque important, 3 Risque élevé, 2 Risque très élevé d'insolvabilité, 1 Risque extrêmement élevé d'insolvabilité, 0 Insolvabilité/procédure préliminaire/dette de règlement" %}
                  <br>
              </td>
            </tr>

          </table>
        </div>


        {% if scoring_automatique.0 %} {{ scoring_automatique.0 }}
          <div style=" background-color: #000066; width: 30%;text-align:center; color: white">{% trans "SCORE AUTOMATIQUE" %} {{annee}}</div>
          <img src="https://backendbucrep.acremac.net/static/scoring_automatique/{{scoring_automatique.0 |floatformat:'0' }}.png" style="width: 100%; height: auto;" />
        {% endif %}

        {% if scoring_automatique.1 %}
          <div style=" background-color: #000066; width: 30%;text-align:center; color: white">{% trans "SCORE AUTOMATIQUE" %} {{annee|add:"-1"}}</div>
          <img src="https://backendbucrep.acremac.net/static/scoring_automatique/{{scoring_automatique.1 |floatformat:'0' }}.png" style="width: 100%; height: auto;" />
        {% endif %}

        {% if scoring_automatique.2 %}
          <div style=" background-color: #000066; width: 30%;text-align:center; color: white">{% trans "SCORE AUTOMATIQUE" %} {{annee|add:"-2"}}</div>
          <img src="https://backendbucrep.acremac.net/static/scoring_automatique/{{scoring_automatique.2 |floatformat:'0' }}.png" style="width: 100%; height: auto;" />
        {% endif %}
           

       <br>
      </div>
    {% endif %}


    {% if scoring_manuel %}
      <table style="width: 40%">
        {% for score in scoring_manuel %}
          <tr>
            <th style=" background-color: #000066; width: 30%;text-align:center; color: white">
              {% trans "SCORE MANUEL" %} {{ score.annee }}
            </th>
            <td style=" background-color: #E3C111; width: 10%;text-align:center">
              <b> {{ score.score|floatformat:"2"|intcomma }}</b>
            </td>
          </tr>
        {% endfor %}
      </table>

        <div>
          <p style="text-align: justify;" style="text-justify: inter-word;">
            <strong style="color:#e3c111">{% trans "Commentaire" %}:</strong>
            <span> </span>
          </p>
        </div>
    {% endif %}