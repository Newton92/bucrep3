# =============================
# Django + Python .gitignore
# =============================

# Python
__pycache__/
*.pyc
*.pyo
*.pyd


# Environnements virtuels
env/
venv/
ENV/
.venv/
env.bak/

# Fichiers de cache Python
__pycache__/
*.py[cod]

# Base de données SQLite
db.sqlite3

# Fichiers médias
media/
main/media/

# Fichiers statiques générés
static/
staticfiles/
main/staticfiles/

# Dossier de documentation
documentation/

# Node modules
node_modules/

# Fichiers de config sensibles
.env
.env.*
.env.db

# Migrations non suivies (optionnel)
**/migrations/__pycache__/
**/migrations/*.pyc
**/migrations/*.log
**/migrations/*.sqlite3

# Django stuff
*.pot
*.mo

# Cache et sessions
*.cache
*.session
*.pid
*.seed
*.pid.lock

# Celery / Channels
celerybeat-schedule
celerybeat.pid

# VSCode
.vscode/

# PyCharm / JetBrains
.idea/
*.iml
*.iws
*.ipr
out/

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Test / Coverage / Build
htmlcov/
.tox/
.nox/
.coverage
coverage.xml
*.cover
*.py,cover
.cache
nosetests.xml
pytest_cache/
test-results/
dist/
build/
*.egg-info/

# Pipenv
Pipfile.lock

# Localisation compilée
locale/*/LC_MESSAGES/*.mo

# Redis ou autres layers temporaires
*.redis

# Data dump
datadump.json


# NOUVEAUX AJOUTS BASÉS SUR VOTRE ARBORESCENCE

# Dossiers et fichiers générés (Débogage)
debug_pdf/
debug_report.html
debug_template.html

# Redis ou autres layers temporaires
*.redis
dump.rdb  # Ajout de la sauvegarde Redis

